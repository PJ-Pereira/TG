# ─────────────────────────────────────────────────────────────
# Configurações do SEI Digital
# Copie este arquivo para ".env" e preencha. O .env NÃO deve ser
# compartilhado nem enviado para o GitHub (contém segredos).
# ─────────────────────────────────────────────────────────────

# Chave usada para assinar a sessão. Gere uma com:
#   python -c "import secrets; print(secrets.token_hex(32))"
# Se ficar vazia, o sistema gera uma automaticamente em instance/secret_key
SECRET_KEY=

# 1 = modo de desenvolvimento (mostra erros detalhados). Em produção: 0
FLASK_DEBUG=0

# 1 = cookie de sessão só trafega por HTTPS (use em produção, com HTTPS ativo)
SESSION_COOKIE_SECURE=0

# Administrador criado na PRIMEIRA execução (banco vazio).
# Se ADMIN_SENHA ficar vazia, uma senha aleatória é gerada e mostrada no terminal.
ADMIN_EMAIL=admin@seidigital.com
ADMIN_SENHA=

# ─────────────────────────────────────────────────────────────
# Envio de email (solicitações de recuperação de senha → administrador)
# O pedido chega ao email cadastrado para o administrador no sistema.
# Sem estas credenciais, o pedido aparece no Painel Administrativo e o texto
# do email é mostrado no terminal (ótimo para testar).
#
# Exemplo com Gmail: ative a verificação em duas etapas e crie uma "senha de app"
# em https://myaccount.google.com/apppasswords  (use ela em MAIL_PASSWORD, não a senha normal)
# ─────────────────────────────────────────────────────────────
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=1
MAIL_USERNAME=
MAIL_PASSWORD=
# Nome/endereço que aparece como remetente (opcional; padrão = MAIL_USERNAME)
MAIL_REMETENTE=

# Endereço do sistema, usado como link no email enviado ao administrador (opcional)
# Ex.: APP_URL=http://127.0.0.1:5000
APP_URL=
